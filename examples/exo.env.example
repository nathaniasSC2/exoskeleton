# /etc/exo/exo.env (mode 640). Every setting with its default is in
# internal/config/config.go.

EXO_NAME=Exo
EXO_DATA=/var/lib/exo
EXO_TZ=America/New_York
# Shared secret between exo's MCP server and the Claude Code processes it starts.
EXO_MCP_TOKEN=change-me-to-a-long-random-string

# Start in dry run: replies are logged, not sent. Flip once it looks right.
EXO_DRY_RUN=1
EXO_DISCORD=1
EXO_DISCORD_TOKEN=

# Brain: Claude Code headless. Its login (CLAUDE_CODE_OAUTH_TOKEN or
# ANTHROPIC_API_KEY) goes in /etc/exo/claude.env, which background jobs read too.
EXO_MODEL=claude-sonnet-5-5
EXO_DEEP_MODEL=claude-opus-5-5

# Fallback and shadow brain: any OpenAI-compatible server (llama.cpp's
# llama-server works best: exo reads /props for the model family and vision).
EXO_LOCAL_URL=http://127.0.0.1:8080/v1
EXO_LOCAL_MODEL=local
EXO_FAILOVER=ask
# EXO_LOCAL_START=sudo systemctl start llama-server
# EXO_LOCAL_STOP=sudo systemctl stop llama-server
# EXO_SHADOW=fast,think

# Long-term notes over MCP (Basic Memory or anything with search_notes/read_note/edit_note).
# EXO_NOTES_MCP=http://127.0.0.1:8766/mcp

# Voice memos: a command that prints the transcript of the file given last.
# EXO_TRANSCRIBE=/opt/whisper/venv/bin/python /opt/whisper/transcribe.py

# EXO_HEARTBEAT=0 8-21/2 * * *
# EXO_SCHEDULE=1
